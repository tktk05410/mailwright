LLM_API_KEY=sk-xxxx
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 切换平台只需改上面三行，任选其一：
# DeepSeek      LLM_BASE_URL=https://api.deepseek.com                        LLM_MODEL=deepseek-chat
# OpenAI        LLM_BASE_URL=https://api.openai.com/v1                        LLM_MODEL=gpt-4o-mini
# Moonshot      LLM_BASE_URL=https://api.moonshot.cn/v1                       LLM_MODEL=moonshot-v1-8k
# 智谱 GLM      LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4             LLM_MODEL=glm-4-flash
# 通义千问      LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1 LLM_MODEL=qwen-plus
# SiliconFlow   LLM_BASE_URL=https://api.siliconflow.cn/v1                    LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# MiniMax       LLM_BASE_URL=https://api.minimax.chat/v1                      LLM_MODEL=abab6.5s-chat
# 阶跃星辰      LLM_BASE_URL=https://api.stepfun.com/v1                       LLM_MODEL=step-2-16k

# 未填写 LLM_API_KEY 时自动降级为离线演示模式
